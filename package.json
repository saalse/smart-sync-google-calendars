{
  "name": "smart-sync-google-calendars",
  "version": "1.0.0",
  "description": "Smart sync multiple Google calendars into one unified calendar using Google Apps Script",
  "private": true,
  "scripts": {
    "deploy": "cd scripts && clasp push",
    "clasp:login": "clasp login",
    "clasp:create": "cd scripts && clasp create-script --type standalone --title \"Smart Sync Google Calendars\" --rootDir .",
    "clasp:open": "cd scripts && clasp open-script",
    "clasp:logs": "cd scripts && clasp tail-logs",
    "clasp:pull": "cd scripts && clasp pull",
    "clasp:status": "cd scripts && clasp show-file-status",
    "clasp:version": "cd scripts && clasp create-version",
    "clasp:deploy": "cd scripts && clasp create-deployment",
    "clasp:deployments": "cd scripts && clasp list-deployments",
    "clasp:redeploy": "cd scripts && clasp update-deployment",
    "test": "node --test \"tests/apps-script/*.test.js\" && npm --prefix worker test",
    "test:apps-script": "node --test \"tests/apps-script/*.test.js\"",
    "test:worker": "npm --prefix worker test"
  },
  "keywords": [
    "google-calendar",
    "calendar-sync",
    "calendar-merge",
    "google-apps-script",
    "calendar-integration",
    "smart-sync",
    "busy-calendar",
    "multi-calendar-sync"
  ],
  "author": {
    "name": "Alex Samson",
    "url": "https://saalse.com"
  },
  "license": "MIT",
  "devDependencies": {
    "@google/clasp": "3.4.1"
  },
  "engines": {
    "node": ">=22"
  }
}
