// Configuration file template
// Copy this file to Config.gs and fill in your actual calendar data

// Calendars to merge from.
// "[X]" is what is placed in front of your calendar event in the shared calendar.
// Use "" if you want none.
const CALENDARS_TO_MERGE = {
  "personal": "your-personal@gmail.com",
  "work1": "work@company1.com",
  "work2": "work@company2.com",
  // Add more calendars as needed
}

// The ID of the shared calendar (the target calendar where all events will be synced)
// Find this by going to calendar settings → "Integrate calendar" → Calendar ID
const CALENDAR_TO_MERGE_INTO = "your-target-calendar-id@group.calendar.google.com"

// Number of days in the past and future to sync.
const SYNC_DAYS_IN_PAST = 30
const SYNC_DAYS_IN_FUTURE = 365

// Default title for events that don't have a title.
const DEFAULT_EVENT_TITLE = "Busy"

// Unique character to use in the title of the event to identify it as a clone.
// This is used to delete the old events.
// https://unicode-table.com/en/200B/
const SEARCH_CHARACTER = "\u200B"

// --- iCloud busy time for the proxy calendar (optional, see docs/icloud-setup.md) ---

// The Worker's address, printed by Cloudflare after "Deploy to Cloudflare", e.g.
// "https://icloud-busy-feed.<your-subdomain>.workers.dev" (no trailing slash). Leave empty to turn iCloud off.
// The token is not set here: setupICloud keeps it in Script Properties.
const ICLOUD_FEED_URL = ""

// iCloud calendars to read, by their display name exactly as shown in Apple Calendar (up to 10 names).
// Leave empty to read all of them (setupICloud prints the names).
const ICLOUD_CALENDARS = [
  // "Calendar A",
  // "Calendar B",
]

const ICLOUD_FLOATING_TIMEZONE = "Europe/Berlin"

// How many days ahead iCloud busy time is read (1 to 366). The past is never read. Keep it short: booking pages
// rarely look further, and a short window keeps the Worker within the Cloudflare Free plan's CPU limit.
const ICLOUD_DAYS_AHEAD = 30

// iCloud reaches the proxy only through MirrorBusy: add "fetchICloudBusyIntervals" to its MIRROR_EXTRA_PROVIDERS,
// then run setupICloud once more to create the trigger.
